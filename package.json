{
  "name": "joymind",
  "version": "0.4.0",
  "private": true,
  "description": "Local-first, auditable agent tool with CLI and Electron desktop",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm build && pnpm -r --if-present test",
    "test:e2e": "pnpm build && pnpm --filter @joymind/e2e test",
    "eval": "pnpm --filter @joymind/evals eval",
    "dev": "pnpm --filter @joymind/desktop dev",
    "dist": "pnpm build && pnpm --filter @joymind/desktop dist"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "typescript": "~5.9.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
